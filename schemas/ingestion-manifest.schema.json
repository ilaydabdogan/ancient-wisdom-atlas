{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ancient-wisdom-atlas/ingestion-manifest.schema.json",
  "title": "Ancient Wisdom Atlas Ingestion Manifest",
  "type": "object",
  "required": ["manifest_version", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "string",
      "enum": ["1"]
    },
    "batch_id": { "type": "string" },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "updated_date": {
      "type": "string",
      "format": "date"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "repo_path": {
      "type": "string",
      "pattern": "^[^/\\\\][^\\\\]*$"
    },
    "checksum": {
      "type": "object",
      "required": ["algorithm", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["sha256", "sha512"]
        },
        "value": {
          "type": "string",
          "minLength": 32
        }
      }
    },
    "path_with_checksum": {
      "type": "object",
      "required": ["path", "checksum"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/repo_path" },
        "checksum": { "$ref": "#/$defs/checksum" },
        "media_type": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "path_only": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/repo_path" },
        "checksum": { "$ref": "#/$defs/checksum" },
        "media_type": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "converter": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "command": { "type": "string" },
        "settings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "rights": {
      "type": "object",
      "required": ["status", "full_text"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "public_domain",
            "public_domain_us",
            "cc0",
            "cc_by",
            "cc_by_sa",
            "cc_by_nc",
            "permissioned",
            "citation_only",
            "unknown"
          ]
        },
        "jurisdiction": { "type": "string" },
        "license_url": { "type": "string" },
        "full_text": {
          "type": "string",
          "enum": ["allowed", "conditional", "blocked", "unknown"]
        },
        "training_use": {
          "type": "string",
          "enum": ["allowed", "conditional", "blocked", "unknown"]
        },
        "notes": { "type": "string" }
      }
    },
    "trademark": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["none", "present", "unknown"]
        },
        "marks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "use_rules": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "needs_changes", "approved", "blocked"]
        },
        "reviewer": { "type": "string" },
        "review_date": {
          "type": "string",
          "format": "date"
        },
        "notes": { "type": "string" }
      }
    },
    "extraction": {
      "type": "object",
      "required": ["readiness"],
      "additionalProperties": false,
      "properties": {
        "readiness": {
          "type": "string",
          "enum": ["not_ready", "needs_cleanup", "ready", "extracted", "blocked"]
        },
        "blocking_issues": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "source_url",
        "fetch_date",
        "raw",
        "converted",
        "canonical",
        "converter",
        "rights",
        "trademark",
        "review",
        "extraction"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "work_id": { "type": "string" },
        "title": { "type": "string" },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "fetch_date": {
          "type": "string",
          "format": "date"
        },
        "raw": { "$ref": "#/$defs/path_with_checksum" },
        "converted": { "$ref": "#/$defs/path_only" },
        "canonical": { "$ref": "#/$defs/path_only" },
        "converter": { "$ref": "#/$defs/converter" },
        "cleanup_notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rights": { "$ref": "#/$defs/rights" },
        "trademark": { "$ref": "#/$defs/trademark" },
        "review": { "$ref": "#/$defs/review" },
        "extraction": { "$ref": "#/$defs/extraction" }
      }
    }
  }
}
