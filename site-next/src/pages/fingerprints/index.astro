---
import Manuscript from '../../layouts/Manuscript.astro';
import { families, motifSlugById, humanize, fmtInt } from '../../lib/atlas.js';

/*
 * What Each Culture Alone Remembers.
 *
 * The inversion of the universals ledger: for every tradition, the motifs and
 * families that it holds while few or no others do. Recomputed from the
 * frequency index at build time. `comparative` is a scholarly cross-tradition
 * category, not a lineage, and is skipped throughout.
 *
 * Tiers of evidence, strongest first:
 *   1. near-unique families  — canonical families attested by <= 3 traditions;
 *   2. dominated motifs      — motifs told elsewhere too, but where one
 *                              tradition holds >= 60% of >= 5 occurrences;
 *   3. unique repeated motifs — motifs attested only in this tradition,
 *                              more than once;
 *   4. singletons            — motifs attested exactly once, only here
 *                              (counted, with a small sample shown).
 */
const NEAR_UNIQUE_FAMILY_MAX = 3;
const DOMINANCE_MIN_OCC = 5;
const DOMINANCE_SHARE = 0.6;
const SINGLETON_SAMPLE = 10;

const slugById = motifSlugById();
const link = (motifId) => (slugById.has(motifId) ? `/motifs/${slugById.get(motifId)}/` : null);

const perTradition = new Map();
const bucket = (t) => {
  if (!perTradition.has(t)) {
    perTradition.set(t, {
      id: t,
      families: [],
      dominated: [],
      uniqueRepeated: [],
      singletonCount: 0,
      singletonSample: [],
    });
  }
  return perTradition.get(t);
};

const seenMotif = new Set();
for (const family of families()) {
  const famTrads = Object.keys(family.traditions).filter((t) => t !== 'comparative');

  // Tier 1: near-unique canonical families.
  if (famTrads.length > 0 && famTrads.length <= NEAR_UNIQUE_FAMILY_MAX) {
    for (const t of famTrads) {
      bucket(t).families.push({
        id: family.id,
        label: family.label,
        occ: family.traditions[t],
        sharedWith: famTrads.filter((o) => o !== t),
      });
    }
  }

  // Motif tiers (dedupe: first — widest-reach — family wins, as elsewhere on the site).
  for (const m of family.mappedMotifs) {
    if (seenMotif.has(m.motif_id)) continue;
    seenMotif.add(m.motif_id);
    const entries = Object.entries(m.traditions ?? {}).filter(([t]) => t !== 'comparative');
    if (entries.length === 0) continue;
    const total = entries.reduce((a, [, v]) => a + v, 0);
    const [topTrad, topOcc] = entries.slice().sort((a, b) => b[1] - a[1])[0];
    const view = {
      id: m.motif_id,
      label: m.label ?? humanize(m.motif_id),
      href: link(m.motif_id),
      familyLabel: family.label,
      occ: topOcc,
      total,
    };
    if (entries.length === 1) {
      if (topOcc >= 2) bucket(topTrad).uniqueRepeated.push(view);
      else {
        const b = bucket(topTrad);
        b.singletonCount += 1;
        b.singletonSample.push(view);
      }
    } else if (total >= DOMINANCE_MIN_OCC && topOcc / total >= DOMINANCE_SHARE) {
      bucket(topTrad).dominated.push(view);
    }
  }
}

const traditions = [...perTradition.values()]
  .map((t) => {
    t.families.sort((a, b) => b.occ - a.occ);
    t.dominated.sort((a, b) => b.occ - a.occ);
    t.uniqueRepeated.sort((a, b) => b.occ - a.occ || a.label.localeCompare(b.label));
    t.singletonSample.sort((a, b) => a.label.localeCompare(b.label));
    t.singletonSample = t.singletonSample.slice(0, SINGLETON_SAMPLE);
    return t;
  })
  .filter(
    (t) => t.families.length || t.dominated.length || t.uniqueRepeated.length || t.singletonCount,
  )
  .sort((a, b) => a.id.localeCompare(b.id));

const uniqueMotifTotal = traditions.reduce(
  (a, t) => a + t.uniqueRepeated.length + t.singletonCount,
  0,
);
---

<Manuscript
  title="Fingerprints — What Each Culture Alone Remembers — Ancient Wisdom Atlas"
  description="The inversion of the universals: for each tradition, the motifs attested only — or almost only — in its own texts."
>
  <div class="folio">
    <section class="story-open" style="padding-bottom: 1rem;">
      <p class="rubric">Fingerprints · the singular</p>
      <h1>What each culture alone remembers</h1>
      <div class="reading">
        <p class="dropcap">
          The <a href="/universals/">universals ledger</a> asks what humankind holds in
          common. This page asks the opposite question of the same index: for each of
          the {fmtInt(traditions.length)} traditions, which motifs does it carry that
          few or no others attest? Across the corpus, {fmtInt(uniqueMotifTotal)} motifs
          are so far attested in one tradition only — the fingerprints beside the
          shared handprint.
        </p>
        <p>
          An honest caution, more needed here than anywhere: <em>uniqueness partly
          reflects coverage, not culture.</em> &ldquo;Only here&rdquo; means only here <em>in the
          corpus so far</em>. A tradition represented by two books will look singular
          wherever those books are idiosyncratic; a motif listed below may be waiting
          in a text we have not yet ingested. Treat these as what each culture alone
          remembers <em>within our present library</em>, and expect this page to shrink
          in places as the library grows.
        </p>
        <p class="footnote">
          Motifs attested only once are counted but shown sparingly — a single
          occurrence is thin evidence. Each motif link opens its evidence page with
          the quoted passage.
        </p>
      </div>
      <p class="tradition-jump" style="margin-top: 1.6rem;">
        {traditions.map((t, i) => (
          <>{i > 0 && <span class="dot" aria-hidden="true" style="color: var(--gold); margin: 0 0.35rem;">·</span>}<a href={`#${t.id}`}>{humanize(t.id)}</a>{' '}</>
        ))}
      </p>
    </section>

    <hr class="asterism" />

    <section>
      {traditions.map((t) => (
        <div class="fingerprint-section" id={t.id}>
          <h2>{humanize(t.id)}</h2>
          <p class="fp-meta">
            {t.uniqueRepeated.length + t.singletonCount > 0 &&
              `${fmtInt(t.uniqueRepeated.length + t.singletonCount)} motifs attested only here`}
            {t.dominated.length > 0 && ` · ${fmtInt(t.dominated.length)} dominated`}
            {t.families.length > 0 && ` · ${fmtInt(t.families.length)} near-unique families`}
          </p>

          {t.families.length > 0 && (
            <>
              <p class="fp-tier">Near-unique families</p>
              <ul class="motif-list">
                {t.families.map((f) => (
                  <li class="motif-item">
                    <div class="motif-line">
                      <span class="motif-name"><a href={`/descent/${f.id}/`}>{f.label}</a></span>
                      <span class="motif-count">
                        {fmtInt(f.occ)} occurrences here
                        {f.sharedWith.length > 0
                          ? ` · shared only with ${f.sharedWith.map(humanize).join(', ')}`
                          : ' · no other tradition attests it'}
                      </span>
                    </div>
                  </li>
                ))}
              </ul>
            </>
          )}

          {t.dominated.length > 0 && (
            <>
              <p class="fp-tier">Told elsewhere, remembered here</p>
              <ul class="motif-list">
                {t.dominated.map((m) => (
                  <li class="motif-item">
                    <div class="motif-line">
                      <span class="motif-name">
                        {m.href ? <a href={m.href}>{m.label}</a> : m.label}
                      </span>
                      <span class="motif-count">
                        {fmtInt(m.occ)} of {fmtInt(m.total)} occurrences here
                        {' '}<span class="fp-family-gloss">· under {m.familyLabel}</span>
                      </span>
                    </div>
                  </li>
                ))}
              </ul>
            </>
          )}

          {t.uniqueRepeated.length > 0 && (
            <>
              <p class="fp-tier">Only here, told more than once</p>
              <ul class="motif-list">
                {t.uniqueRepeated.map((m) => (
                  <li class="motif-item">
                    <div class="motif-line">
                      <span class="motif-name">
                        {m.href ? <a href={m.href}>{m.label}</a> : m.label}
                      </span>
                      <span class="motif-count">
                        {fmtInt(m.occ)} occurrences
                        {' '}<span class="fp-family-gloss">· under {m.familyLabel}</span>
                      </span>
                    </div>
                  </li>
                ))}
              </ul>
            </>
          )}

          {t.singletonCount > 0 && (
            <>
              <p class="fp-tier">Attested once, only here</p>
              <ul class="motif-list">
                {t.singletonSample.map((m) => (
                  <li class="motif-item">
                    <div class="motif-line">
                      <span class="motif-name">
                        {m.href ? <a href={m.href}>{m.label}</a> : m.label}
                      </span>
                      <span class="motif-count">
                        1 occurrence <span class="fp-family-gloss">· under {m.familyLabel}</span>
                      </span>
                    </div>
                  </li>
                ))}
              </ul>
              {t.singletonCount > t.singletonSample.length && (
                <p class="footnote" style="margin-top: 0.6rem;">
                  …and {fmtInt(t.singletonCount - t.singletonSample.length)} further
                  motifs attested a single time only in this tradition.
                </p>
              )}
            </>
          )}
        </div>
      ))}
    </section>

    <section class="story-section">
      <div class="reading">
        <p class="footnote">
          Method: from the canonical frequency index, a motif is credited to a
          tradition when that tradition alone attests it, or when it holds at least
          {' '}{Math.round(DOMINANCE_SHARE * 100)}% of a motif&rsquo;s {fmtInt(DOMINANCE_MIN_OCC)}+
          occurrences; a family is near-unique when {fmtInt(NEAR_UNIQUE_FAMILY_MAX)} or
          fewer traditions attest it. The `comparative` category is excluded
          throughout. The mirror of this page is
          <a href="/universals/"> the most shared stories of humankind</a>.
        </p>
      </div>
    </section>
  </div>
</Manuscript>
