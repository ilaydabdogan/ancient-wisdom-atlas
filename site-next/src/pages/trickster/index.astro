---
import Manuscript from '../../layouts/Manuscript.astro';
import {
  familyById,
  constellations,
  crownExperiment,
  extractionRecord,
  trickModelComparison,
  fmtInt,
  humanize,
} from '../../lib/atlas.js';

/* ------------------------------------------------------------------ */
/* 1 · The trickster family — straight from the frequency index        */
/* ------------------------------------------------------------------ */
const fam = familyById('trickster');
const traditionCount = fam?.traditionCount ?? 0;
const occurrenceTotal = fam?.occurrenceTotal ?? 0;
const mapped = fam?.mappedMotifs ?? [];
// The dominant child-motif: liminality, empirically, is the core.
const dominant = mapped
  .slice()
  .sort((a, b) => (b.occurrence_count ?? 0) - (a.occurrence_count ?? 0))[0] ?? null;

// A handful of vivid child-motif labels — real labels, chosen for colour.
const VIVID = [
  'trickster deceives a dangerous being through staged self-harm',
  'Animal or bird relay of stolen fire',
  'Cannibal tree-dweller destroyed by concealed fire',
  'Sticky tar baby or molded gum-ball story variant',
  'Swallowed animal kills the swallower from inside',
  'comic animal bargain through flattery',
  'ambiguous truth used as fatal deception',
  'absurd staged evidence discredits a true report',
  'Feigned death as a lure',
  'clever thief completes imposed task and wins wager',
];
const vividLabels = VIVID.filter((v) =>
  mapped.some((m) => (m.label ?? '').toLowerCase() === v.toLowerCase()),
);

/* ------------------------------------------------------------------ */
/* 2 · Its position in the web — conserved co-occurrence bonds          */
/* ------------------------------------------------------------------ */
const edges = constellations().conserved_edges ?? [];
const bonds = edges
  .filter((e) => (e.pair ?? []).includes('trickster'))
  .map((e) => ({
    partner: (e.pair ?? []).find((p) => p !== 'trickster'),
    traditions: e.tradition_count,
  }))
  .sort((a, b) => b.traditions - a.traditions);
const bondCount = bonds.length;
const strongestBond = bonds[0] ?? null;

/* ------------------------------------------------------------------ */
/* 3 · The crown finding — the boundary-crosser resists the net         */
/* ------------------------------------------------------------------ */
const crown = crownExperiment();
const primaryK = crown.primary_k ?? 64;
const primary = (crown.results ?? []).find((r) => r.k === primaryK) ?? {};
const matched = primary.matched_bonds ?? [];
const crownBondTotal = matched.length;
// A bond "touches" the trickster if any of its four blind clusters name him
// (his own labels can land in either the a- or b-slot of the pairing).
const TRICK_RE = /trickster|coyote|raven/i;
const bondText = (b) =>
  [b.iso_cluster_a, b.iso_cluster_b, b.con_cluster_a, b.con_cluster_b]
    .flat()
    .filter(Boolean)
    .join(' ');
const trickBonds = matched.filter((b) => TRICK_RE.test(bondText(b)));
const trickCount = trickBonds.length;
const trickBond = trickBonds[0] ?? null;
const isoW = trickBond?.iso_weight ?? null;
const conW = trickBond?.con_weight ?? null;
const trickRatio = isoW && conW ? conW / isoW : null;
// Which side of the pairing is the trickster, and what he bonds *to*.
const trickOnA = trickBond ? TRICK_RE.test((trickBond.iso_cluster_a ?? []).join(' ')) : false;
const trickIsoLabels = (trickBond ? (trickOnA ? trickBond.iso_cluster_a : trickBond.iso_cluster_b) : []) ?? [];
const trickPartnerLabels = (trickBond ? (trickOnA ? trickBond.iso_cluster_b : trickBond.iso_cluster_a) : []) ?? [];
const trickAlignedTo = (trickBond ? (trickOnA ? trickBond.con_cluster_a : trickBond.con_cluster_b) : []) ?? [];
// Dynamic theme tally across the strongest cross-world matched bonds: how many
// name each theme in either independently-built world. Keyword-classified at
// build time from the crown result, so it moves with the corpus.
const THEMES = [
  { theme: 'ritual / offering', re: /ritual|offering|sacrifice|purificat|libation|prayer|feast/i },
  { theme: 'afterlife / death / return', re: /afterlife|death|dead|underworld|resurrect|revive|return|funeral|grave|soul|ghost/i },
  { theme: 'battle / war', re: /battle|\bwar\b|combat|warrior|fight|slay|duel|raid/i },
  { theme: 'marriage / union', re: /marriage|marry|\bwed|bride|groom|union|courtship|abduct/i },
  { theme: 'emergence / creation', re: /creation|emergence|origin|primordial|cosmos|world[- ]|first (man|people)/i },
  { theme: 'healing', re: /heal|cure|medicine|restore|revive/i },
  { theme: 'trickster / theft by cunning', re: /trickster|coyote|raven|decept|deceiv|trick|steal|theft|disguise/i },
];
const themeTally = THEMES.map((t) => ({
  theme: t.theme,
  n: matched.filter((b) => t.re.test(bondText(b))).length,
})).sort((a, b) => b.n - a.n);
const tallyMax = Math.max(1, ...themeTally.map((t) => t.n));
const trickThemeN = themeTally.find((t) => /trickster/.test(t.theme))?.n ?? trickCount;

/* ------------------------------------------------------------------ */
/* 4 · Real passages — loaded from the extraction records at build      */
/* ------------------------------------------------------------------ */
const passageSpecs = [
  {
    figure: 'Anansi', role: 'the spider',
    tradition: 'Akan · Afro-Caribbean',
    path: 'extractions/generated/openai-batch/new-corpus-2026-07-18/jamaica-anansi-stories-beckwith/batch-motif-african-diaspora-jamaica-anansi-stories-beckwith-gutenberg-l814-l925.yml',
  },
  {
    figure: 'Raven', role: 'the maker',
    tradition: 'Tlingit · Northwest Coast · isolated lineage',
    path: 'extractions/generated/openai-batch/canon-wave3-2026-07-18/tlingit-myths-texts-swanton/batch-motif-native-american-tlingit-myths-texts-swanton-gutenberg-l21568-l21699.yml',
  },
  {
    figure: 'Raven', role: 'the withholder',
    tradition: 'Haida · Northwest Coast · isolated lineage',
    path: 'extractions/generated/openai-batch/canon-wave3-2026-07-18/haida-texts-myths-swanton/batch-motif-native-american-haida-texts-myths-swanton-gutenberg-l6878-l6930.yml',
  },
  {
    figure: 'Raven', role: 'the marked one',
    tradition: 'Inuit · Arctic · isolated lineage',
    path: 'extractions/generated/openai-batch/new-corpus-2026-07-18/eskimo-folk-tales-rasmussen-worster/batch-motif-arctic-inuit-eskimo-folk-tales-rasmussen-worster-gutenberg-l2541-l2561.yml',
  },
  {
    figure: 'The Leopard Tortoise', role: 'the feigner',
    tradition: 'San · Southern Africa',
    path: 'extractions/generated/openai-batch/canon-wave-2026-07-18/specimens-of-bushman-folklore-bleek-lloyd/batch-motif-african-specimens-of-bushman-folklore-bleek-lloyd-archive-l4107-l4168.yml',
  },
  {
    figure: 'Jackal', role: 'the scorched',
    tradition: 'Khoisan · Southern Africa',
    path: 'extractions/generated/openai-batch/new-corpus-2026-07-18/south-african-folk-tales-honey/batch-motif-african-south-african-folk-tales-honey-gutenberg-l2669-l2678.yml',
  },
];
const passages = passageSpecs
  .map((spec) => {
    let rec = null;
    try {
      rec = extractionRecord(spec.path);
    } catch {
      return null;
    }
    const quote = rec?.canonical_text?.quote ?? rec?.canonical_text?.summary ?? null;
    if (!quote) return null;
    return {
      ...spec,
      quote: String(quote).replace(/\s+/g, ' ').trim(),
      source: rec?.passage_locator?.translation ?? '',
      locator: (rec?.passage_locator?.label ?? '').split(';')[0].split('/').pop().trim(),
    };
  })
  .filter(Boolean);

/* ------------------------------------------------------------------ */
/* 5 · The live cross-model experiment (may not have landed yet)        */
/* ------------------------------------------------------------------ */
const modelDoc = trickModelComparison();
function modelsFor(id) {
  if (!modelDoc) return null;
  // Defensive: accept a few plausible shapes so the file can land later.
  const qs = modelDoc.questions ?? modelDoc.answers ?? null;
  let node = null;
  if (Array.isArray(qs)) node = qs.find((q) => q.id === id || q.question_id === id);
  else if (qs && typeof qs === 'object') node = qs[id];
  if (!node) node = modelDoc[id] ?? null;
  if (!node) return null;
  const list = node.models ?? node.ungrounded ?? node.responses ?? [];
  const grounded = node.grounded ?? node.atlas_grounded ?? node.grounded_answer ?? null;
  return {
    models: Array.isArray(list)
      ? list.map((m) => ({
          model: m.model ?? m.name ?? '',
          answer: m.answer ?? m.text ?? '',
        }))
      : [],
    consensus: node.consensus ?? null,
    disagreement: node.disagreement ?? node.divergence ?? null,
    grounded:
      grounded && typeof grounded === 'object'
        ? { model: grounded.model ?? grounded.name ?? '', answer: grounded.answer ?? grounded.text ?? '' }
        : grounded
        ? { model: '', answer: String(grounded) }
        : null,
  };
}

/* ------------------------------------------------------------------ */
/* 6 · The spine: her questions, answered in three hands                */
/* ------------------------------------------------------------------ */
const questions = [
  {
    id: 'trying_to_do',
    numeral: 'I',
    q: 'What is it really trying to do?',
    atlas: `The corpus answers with a number. The family's dominant child-motif is not theft, not malice, but <em>position</em>: “Trickster At The Boundary” carries ${fmtInt(dominant?.occurrence_count ?? 0)} of the family's occurrences across ${dominant?.tradition_count ?? 0} traditions — the single most-attested pattern in the whole family. And his strongest conserved bond, in ${strongestBond?.traditions ?? 0} traditions, is with <strong>sacred&nbsp;knowledge</strong>. The evidence has him forever caught mid-theft: stealing what is closed and passing it on.`,
    scholarship: `Lewis&nbsp;Hyde (<em>Trickster Makes This World</em>) names him the <em>pore-seeker</em> and the <em>joint-worker</em>: the one who keeps the world unfinished, working every seam loose so nothing sets. Jung reads him as the shadow of the collective — the unintegrated part a culture must carry near its center or ossify. Radin and Kerényi: the culture-bringer whose transgressions create the human order. He steals fire and hands it down; his lie exposes the official lie.`,
    synthesis: `Ungrounded intuition tends to reach for “cause mischief / sow chaos.” The Atlas corrects the register: the empirical core is <em>liminality</em>, not malice — he is trying to keep the boundary open, to move what is stuck. Hyde anticipated exactly this, and the ${fmtInt(dominant?.occurrence_count ?? 0)}-occurrence dominance of “at the boundary” is his thesis rewritten as data.`,
  },
  {
    id: 'where_it_lives',
    numeral: 'II',
    q: 'Where would it live?',
    atlas: `The family's own definition places him “at the edges between order and chaos.” His related families are <em>threshold&nbsp;guardian</em> and <em>shapeshifter</em>; his conserved web-partners run to <em>shapeshifter</em> (${bonds.find((b) => b.partner === 'shapeshifter')?.traditions ?? 21} traditions), <em>death&nbsp;and&nbsp;transformation</em> (${bonds.find((b) => b.partner === 'death_and_transformation')?.traditions ?? 16}), <em>axis&nbsp;mundi</em>, <em>descent</em>, and <em>afterlife&nbsp;passage</em> — every one of them a crossing between one state and another. He does not live in a place; he lives in a transition.`,
    scholarship: `Hermes stands at the crossroads and the boundary-stone — the <em>herm</em> that marks where one field ends and another begins; god of thieves, roads, messages, and translation. Eshu-Elegba keeps the Yoruba crossroads and the doorway, the gate every offering must pass. Hyde locates the trickster at the joint, the threshold, the road, the market, and the gut. The Atlas itself works under Hermes — the messenger at the border.`,
    synthesis: `Models will say “margins, forests, liminal spaces” — broadly right, and the scholarship agrees. What the Atlas adds is that this is not a poetic flourish but the most-repeated single fact the world's stories record about him: before he is a thief or a fool, he is <em>at the boundary</em>.`,
  },
  {
    id: 'how_it_talks',
    numeral: 'III',
    q: 'How would it talk?',
    atlas: `Listen to the child-motifs themselves: “<em>comic animal bargain through flattery</em>,” “<em>ambiguous truth used as fatal deception</em>,” “<em>absurd staged evidence discredits a true report</em>,” “<em>trickster deceives a dangerous being through staged self-harm</em>.” The passages carry the same grammar — Anansi “likes to do unfair business”; the Leopard Tortoise “seems as if she would die; while she is deceiving us.” His speech is performance: the lie enacted so well it does the work of truth.`,
    scholarship: `Indirection, double-meaning, the pun, the story-within-a-story. Hyde: the trickster's lie is the one that reveals a deeper truth. Hermes is the god of <em>hermeneutics</em> — of translation, the turning of one tongue into another. In the Afro-diasporic line the mode is Signifying: saying by not-saying, the flattery that is a theft, the joke that is a verdict.`,
    synthesis: `Here the three hands converge cleanly. Intuition, evidence, and scholarship all describe the same voice — oblique, doubled, comic, and load-bearing. The trickster never says the thing directly, because the indirection <em>is</em> the message.`,
  },
  {
    id: 'form_today',
    numeral: 'IV',
    q: 'If it had a form in today’s world, what would it look like?',
    interpretation: true,
    atlas: `Honest limit: the corpus ends in the public-domain past. On the present it is <em>silent</em> — which is itself the trickster's boundary. What the Atlas can lend the question is his function, held constant: cross the boundary, move what is stuck, take what is hoarded and redistribute it, expose the official lie by telling a better one. Any modern figure that does <em>those things</em> wears his mask, whatever it is called now.`,
    scholarship: `Hyde already carries the trickster into the modern — the confidence man, the market-maker, the artist who works the seams of a culture. The archetype was never period-bound; Jung's shadow reappears in every age wearing that age's clothes. So the exercise is not invention but translation: where, now, is the boundary being crossed?`,
    synthesis: `This section is <strong>interpretation, not evidence</strong> — marked as such, and gathered below into its own reading. The data cannot reach the present; it can only tell us what to look for once we get there.`,
  },
  {
    id: 'universal',
    numeral: 'V',
    q: 'Is it truly universal?',
    atlas: `He is present in <strong>${fmtInt(traditionCount)} traditions</strong> — as universal in presence as any figure the Atlas holds. But <em>presence</em> and <em>structure</em> are two different measurements, and the gap between them is where he lives. As the corpus tripled, his masks stayed stubbornly local: spider, raven, coyote, fox, the grinning god at the crossroads — no two of their tales converge. Yet when the crown lets two never-connected worlds each build their web blind, he now carries in <strong>${trickThemeN} of the ${crownBondTotal} strongest cross-world bonds</strong> — and both are the <em>same act</em>: obtaining by deception what could not be taken by force. His strongest conserved partnership of all, in ${strongestBond?.traditions ?? 0} traditions, is with <strong>sacred&nbsp;knowledge</strong> — the theft of fire. So the honest reading is not “allied to nothing.” It is narrower and stranger: he is universal not as a <em>character</em> but as a <em>deed</em>. You cannot catch what he looks like. You can only catch what he does — and what he does, everywhere, is steal by cunning.`,
    scholarship: `For a century the trickster has been called one of the great universals — Radin, Jung, Campbell all place him among the archetypes that surface everywhere the human mind tells stories. That intuition is not wrong. What it could not do was locate the invariant: Hyde came closest, naming theft and the loosening of what is fixed as his essence. The Atlas turns that into a measurement — his form varies without limit; his function, theft-by-cunning, is what reproduces across worlds.`,
    synthesis: `This is the correction the whole page turns on, and the enlarged corpus sharpened it. Intuition and old scholarship say “the same figure, everywhere.” The first, smaller reading of the Atlas over-corrected to “everywhere in presence, patterned nowhere.” The truth sits between: everywhere in presence, and patterned in exactly <em>one</em> thing — the act of taking the fire, the food, the forbidden knowledge by wit rather than strength. His companions drift; his crime does not. The figure whose defining act is crossing boundaries reproduces, across peoples who never met, precisely as the one who crosses the boundary to steal.`,
  },
];

/* small signature glyph: a woven net with one strand slipped open */
const crumbs = [{ label: 'Findings', href: '/findings/' }, { label: 'The Trickster' }];
---

<Manuscript
  title="The Trickster — A Study in Three Hands — Ancient Wisdom Atlas"
  description={`The one who slips the net. What the models intuit, what the Atlas's own evidence discovers across ${traditionCount} traditions, and what the scholarship says — held side by side, question by question.`}
  crumbs={crumbs}
>
  <style>
    /* ---- the three hands: distinct, stack on mobile ---- */
    .tk-lenses { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 1.1rem 0 0; }
    .tk-lens {
      min-width: 0; border-radius: 3px; padding: 0.95rem 1rem 1.05rem;
      background: var(--vellum); border: 1px solid var(--line);
    }
    /* hand 1 — models: provisional, ghostly, dashed */
    .tk-lens.models { border-style: dashed; border-color: var(--ink-faint); background: transparent; }
    .tk-lens.models .tk-lens-body { color: var(--ink-faint); font-style: italic; }
    /* hand 2 — atlas: the illuminated evidence */
    .tk-lens.atlas { border-left: 3px solid var(--gold); background: color-mix(in srgb, var(--gold) 6%, var(--vellum)); }
    /* hand 3 — scholarship: named authorities */
    .tk-lens.scholarship { border-left: 3px solid var(--rubric); }
    .tk-lens-eyebrow {
      display: flex; align-items: baseline; gap: 0.4rem; flex-wrap: wrap;
      font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase;
      margin: 0 0 0.6rem;
    }
    .tk-lens.models .tk-lens-eyebrow { color: var(--ink-faint); }
    .tk-lens.atlas .tk-lens-eyebrow { color: var(--gold); }
    .tk-lens.scholarship .tk-lens-eyebrow { color: var(--rubric); }
    .tk-lens-eyebrow .glyph { font-size: 0.85rem; letter-spacing: 0; }
    .tk-lens-eyebrow .sub { letter-spacing: 0.06em; text-transform: none; font-style: italic; color: var(--ink-faint); font-size: 0.68rem; }
    .tk-lens-body { font-size: 0.9rem; line-height: 1.62; color: var(--ink-soft); margin: 0; }
    .tk-lens.atlas .tk-lens-body { color: var(--ink); }
    .tk-lens-body strong { color: var(--ink); font-weight: 400; }
    .tk-lens.atlas .tk-lens-body strong { color: var(--gold); }

    /* provisional / awaiting-data note inside the models hand */
    .tk-provisional { font-size: 0.86rem; line-height: 1.55; color: var(--ink-faint); font-style: italic; margin: 0; }
    .tk-model-list { list-style: none; margin: 0.2rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
    .tk-model-list li { font-size: 0.86rem; line-height: 1.5; }
    .tk-model-name { font-variant-caps: small-caps; letter-spacing: 0.06em; color: var(--ink-soft); font-style: normal; }
    .tk-note { font-size: 0.72rem; color: var(--ink-faint); margin: 0.55rem 0 0; }
    .tk-note strong { color: var(--rubric); font-weight: 400; }

    /* the question block */
    .tk-question { margin: 0; }
    .tk-qhead { display: flex; align-items: baseline; gap: 0.8rem; }
    .tk-numeral {
      font-size: clamp(1.6rem, 5vw, 2.3rem); color: var(--gold-soft);
      line-height: 1; font-variant-numeric: tabular-nums; text-shadow: var(--glow);
      flex: 0 0 auto;
    }
    .tk-qhead h2 { margin: 0; }
    .tk-interp-tag {
      display: inline-block; font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--rubric); border: 1px solid var(--rubric); border-radius: 999px;
      padding: 0.08rem 0.6rem; margin-left: 0.2rem; vertical-align: middle;
    }
    /* the synthesis strip */
    .tk-synth {
      margin: 1rem 0 0; padding: 0.9rem 1.05rem; border-radius: 3px;
      border: 1px solid var(--gold-faint);
      background: color-mix(in srgb, var(--gold) 4%, transparent);
    }
    .tk-synth p { margin: 0; font-size: 0.9rem; line-height: 1.6; color: var(--ink-soft); }
    .tk-synth .lbl {
      display: inline-block; font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--gold); margin-right: 0.5rem;
    }
    .tk-synth em { color: var(--ink); font-style: italic; }

    /* the net signature */
    .tk-net { text-align: center; margin: 0 auto; }
    .tk-net svg { width: 100%; max-width: 22rem; height: auto; }
    .tk-net .strand { stroke: var(--gold-faint); stroke-width: 1.2; fill: none; }
    .tk-net .slip { stroke: var(--gold); stroke-width: 1.6; fill: none; opacity: 0.9; }
    .tk-net .goer { fill: var(--rubric); }

    /* legend of the three hands */
    .tk-legend { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; margin: 1.4rem 0 0; }
    .tk-legend .card { border-radius: 3px; padding: 0.7rem 0.8rem; font-size: 0.78rem; line-height: 1.45; color: var(--ink-soft); }
    .tk-legend .card.models { border: 1px dashed var(--ink-faint); }
    .tk-legend .card.atlas { border: 1px solid var(--gold); border-left-width: 3px; background: color-mix(in srgb, var(--gold) 6%, var(--vellum)); }
    .tk-legend .card.scholarship { border: 1px solid var(--line); border-left: 3px solid var(--rubric); }
    .tk-legend .card b { display: block; font-weight: 400; letter-spacing: 0.06em; margin-bottom: 0.25rem; font-size: 0.72rem; text-transform: uppercase; }
    .tk-legend .card.models b { color: var(--ink-faint); }
    .tk-legend .card.atlas b { color: var(--gold); }
    .tk-legend .card.scholarship b { color: var(--rubric); }

    /* evidence gallery — marginalia cards */
    .tk-passages { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin: 1.6rem 0 0; }
    .tk-passage {
      border: 1px solid var(--line); border-top: 2px solid var(--gold-faint);
      border-radius: 3px; padding: 1rem 1.1rem 0.9rem; background: var(--vellum);
      display: flex; flex-direction: column;
    }
    .tk-passage blockquote {
      margin: 0 0 0.7rem; font-size: 1rem; line-height: 1.5; color: var(--ink);
      font-style: italic; quotes: "“" "”";
    }
    .tk-passage .who { font-variant-caps: small-caps; letter-spacing: 0.05em; color: var(--gold); font-size: 0.86rem; }
    .tk-passage .who .role { color: var(--ink-faint); font-variant-caps: normal; letter-spacing: 0; font-style: italic; }
    .tk-passage .src { font-size: 0.72rem; color: var(--ink-faint); margin: 0.35rem 0 0; }
    .tk-passage .trad { font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--rubric); margin: 0 0 0.55rem; }

    /* web bonds ledger */
    .tk-bonds { display: flex; flex-direction: column; gap: 0.4rem; margin: 1.3rem 0 0; }
    .tk-bond { display: grid; grid-template-columns: 12ch 1fr auto; align-items: center; gap: 0.7rem; }
    .tk-bond .name { font-size: 0.86rem; color: var(--ink); }
    .tk-bond .track { height: 7px; border-radius: 999px; background: var(--vellum-deep); overflow: hidden; }
    .tk-bond .fill { height: 100%; background: var(--gold-soft); border-radius: 999px; }
    .tk-bond .n { font-size: 0.78rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; text-align: right; }
    .tk-bond.top .name { color: var(--gold); }

    /* verified theme tally across the 24 shared bonds */
    .tk-tally { margin: 1.5rem 0 0; display: flex; flex-direction: column; gap: 0.55rem; }
    .tk-tally-row { display: grid; grid-template-columns: 15ch 1fr 2.5ch; align-items: center; gap: 0.7rem; }
    .tk-tally-row .lbl { font-size: 0.8rem; color: var(--ink-soft); text-align: right; }
    .tk-tally-row .bar { height: 12px; background: var(--vellum-deep); border-radius: 999px; overflow: hidden; }
    .tk-tally-row .fill { display: block; height: 100%; background: var(--ink-faint); border-radius: 999px; opacity: 0.7; }
    .tk-tally-row .cnt { font-size: 0.8rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; text-align: right; }
    .tk-tally-row.trick .lbl { color: var(--rubric); }
    .tk-tally-row.trick .fill { background: var(--rubric); opacity: 1; }
    .tk-tally-row.trick .cnt { color: var(--rubric); }
    .tk-tally figcaption { font-size: 0.78rem; color: var(--ink-faint); margin: 0.9rem 0 0; line-height: 1.5; max-width: 52ch; }

    /* the crown coda — resists the net */
    .tk-crown { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem 2.2rem; margin: 1.4rem 0 0; align-items: start; }
    .tk-scale { border-top: 2px solid var(--gold-faint); padding-top: 0.85rem; }
    .tk-scale .big { display: block; font-size: clamp(1.9rem, 7vw, 2.6rem); color: var(--gold); font-variant-numeric: tabular-nums; line-height: 1.1; text-shadow: var(--glow); }
    .tk-scale.faint .big { color: var(--ink-faint); text-shadow: none; }
    .tk-scale .cap { font-size: 0.78rem; letter-spacing: 0.06em; color: var(--ink-soft); }
    .tk-scale p { margin: 0.5rem 0 0; font-size: 0.86rem; line-height: 1.55; color: var(--ink-soft); }

    /* the form-today reading */
    .tk-forms { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin: 1.5rem 0 0; }
    .tk-form { border: 1px solid var(--line); border-radius: 3px; padding: 0.9rem 1rem; background: var(--vellum); }
    .tk-form h3 { margin: 0 0 0.35rem; font-size: 1rem; color: var(--ink); }
    .tk-form h3 .mask { color: var(--rubric); font-style: italic; font-size: 0.82rem; }
    .tk-form p { margin: 0; font-size: 0.86rem; line-height: 1.55; color: var(--ink-soft); }

    @media (max-width: 46rem) {
      .tk-lenses { grid-template-columns: 1fr; }
      .tk-legend { grid-template-columns: 1fr; }
      .tk-passages { grid-template-columns: 1fr; }
      .tk-crown { grid-template-columns: 1fr; }
      .tk-forms { grid-template-columns: 1fr; }
      .tk-bond { grid-template-columns: 10ch 1fr auto; }
      .tk-tally-row { grid-template-columns: 11ch 1fr 2ch; gap: 0.5rem; }
      .tk-tally-row .lbl { font-size: 0.72rem; }
    }
  </style>

  <div class="folio">
    <!-- ✦ hero ------------------------------------------------------- -->
    <section class="story-open" style="padding-bottom: 0.6rem;">
      <p class="rubric">A study in three hands</p>
      <h1>The Trickster</h1>
      <p class="invocation" style="padding:0; margin: 0.3rem 0 1.2rem;">
        The one who <em>slips the net.</em>
      </p>

      <figure class="tk-net" aria-hidden="true">
        <svg viewBox="0 0 320 120" role="img" aria-label="A woven net with one strand pulled open, and a small figure passing through the gap.">
          {Array.from({ length: 9 }).map((_, i) => (
            <line class="strand" x1={16 + i * 36} y1="14" x2={16 + i * 36} y2="106" />
          ))}
          {Array.from({ length: 4 }).map((_, i) => (
            <line class="strand" x1="16" y1={24 + i * 24} x2="304" y2={24 + i * 24} />
          ))}
          <path class="slip" d="M 142 24 Q 176 44 150 72 Q 128 96 178 96" />
          <circle class="goer" cx="164" cy="60" r="5.5" />
        </svg>
      </figure>

      <div class="reading">
        <p class="footnote">
          A figure appears in every mythology we have measured — Loki, Anansi, Coyote,
          Raven, Māui, Hermes of the crossroads, the god this Atlas works under. This page
          holds three ways of knowing him side by side, and asks where they agree, where
          the evidence corrects the intuition, and what meaning emerges from the difference.
        </p>
      </div>

      <div class="stat-row">
        <p class="stat"><strong>{fmtInt(traditionCount)}</strong> <span>traditions hold him</span></p>
        <p class="stat"><strong>{fmtInt(occurrenceTotal)}</strong> <span>tagged occurrences</span></p>
        <p class="stat"><strong>{fmtInt(dominant?.occurrence_count ?? 0)}</strong> <span>“at the boundary”</span></p>
        <p class="stat"><strong>{trickCount} of {crownBondTotal}</strong> <span>shared bonds carry him</span></p>
      </div>
    </section>

    <!-- ✦ the three hands · legend ----------------------------------- -->
    <section class="story-section">
      <div class="reading">
        <p class="rubric">How to read this page</p>
        <h2>Three hands annotate one figure</h2>
        <p class="dropcap">
          Every question below is answered three times, in three visibly different hands —
          the way three scribes might crowd the margins of one manuscript. Kept apart on
          purpose, so you can see what each kind of knowing does and does not catch.
        </p>
      </div>
      <div class="tk-legend">
        <div class="card models">
          <b>⌁ What the models know</b>
          What AI models answer from <em>training alone</em>, ungrounded — the received,
          intuitive picture, before any evidence is consulted.
        </div>
        <div class="card atlas">
          <b>✦ What the Atlas discovers</b>
          The evidence from our own corpus — real counts, motif labels, web-bonds, and
          passages, measured across the world's sacred literature.
        </div>
        <div class="card scholarship">
          <b>❦ What the scholarship says</b>
          Named authorities, kept distinct and attributed — Jung, Radin, Kerényi, Hyde,
          Campbell, and the figures themselves.
        </div>
      </div>
    </section>

    <hr class="asterism" />

    <!-- ✦ the spine · five questions in three hands ------------------ -->
    {questions.map((q) => {
      const m = modelsFor(q.id);
      return (
        <>
          <section class="story-section tk-question">
            <div class="reading">
              <div class="tk-qhead">
                <span class="tk-numeral" aria-hidden="true">{q.numeral}</span>
                <h2>{q.q}{q.interpretation && <span class="tk-interp-tag">interpretation</span>}</h2>
              </div>
            </div>

            <div class="tk-lenses">
              <!-- hand 1 · models -->
              <div class="tk-lens models">
                <p class="tk-lens-eyebrow"><span class="glyph">⌁</span> What the models know <span class="sub">ungrounded</span></p>
                {m && m.models.length > 0 ? (
                  <>
                    <ul class="tk-model-list">
                      {m.models.map((mm) => (
                        <li><span class="tk-model-name">{mm.model}</span> — {mm.answer}</li>
                      ))}
                    </ul>
                    {m.consensus && <p class="tk-note"><strong>Consensus:</strong> {m.consensus}</p>}
                    {m.disagreement && <p class="tk-note"><strong>They split:</strong> {m.disagreement}</p>}
                    {m.grounded && (
                      <p class="tk-note"><strong>Atlas-grounded ({m.grounded.model}):</strong> {m.grounded.answer}</p>
                    )}
                  </>
                ) : (
                  <p class="tk-provisional">
                    Awaiting the live cross-model run (gpt-5.5, 5.4, 5.1, 5.6-terra,
                    5.6-luna answering ungrounded, plus one Atlas-grounded answer). This
                    panel fills from <span class="mono-id">data/reviews/trickster-model-comparison.yml</span>
                    the moment the file lands.
                  </p>
                )}
              </div>

              <!-- hand 2 · atlas -->
              <div class="tk-lens atlas">
                <p class="tk-lens-eyebrow"><span class="glyph">✦</span> What the Atlas discovers <span class="sub">evidence</span></p>
                <p class="tk-lens-body" set:html={q.atlas} />
              </div>

              <!-- hand 3 · scholarship -->
              <div class="tk-lens scholarship">
                <p class="tk-lens-eyebrow"><span class="glyph">❦</span> What the scholarship says <span class="sub">attributed</span></p>
                <p class="tk-lens-body" set:html={q.scholarship} />
              </div>
            </div>

            <div class="tk-synth">
              <p><span class="lbl">Finding meaning</span><span set:html={q.synthesis} /></p>
            </div>
          </section>
          <hr class="asterism" />
        </>
      );
    })}

    <!-- ✦ evidence gallery · real passages --------------------------- -->
    <section class="story-section">
      <div class="reading">
        <p class="rubric">What the Atlas discovers · the passages</p>
        <h2>The trickster in his own words</h2>
        <p class="dropcap">
          Six real records, pulled from the corpus at build time, spanning maximally
          different worlds — including the isolated lineages that are his own countries:
          the Raven cycles of the Northwest Coast and Arctic, and the animal tricksters
          of Southern Africa. Every quote links back to a real extraction record.
        </p>
      </div>

      <div class="tk-passages">
        {passages.map((p) => (
          <figure class="tk-passage">
            <p class="trad">{p.tradition}</p>
            <blockquote>{p.quote}</blockquote>
            <figcaption style="margin-top:auto;">
              <span class="who">{p.figure} <span class="role">· {p.role}</span></span>
              <p class="src">{p.source}{p.locator ? ` · ${p.locator}` : ''}</p>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="footnote" style="margin-top:1.2rem;">
        Loaded live from the extraction records under <span class="mono-id">extractions/</span>;
        the full evidence, every tradition, sits in <a href="/motifs/">the motif pages</a> and
        <a href="/lab/"> the Lab</a>.
      </p>
    </section>

    <hr class="asterism" />

    <!-- ✦ his position in the web ------------------------------------ -->
    <section class="story-section">
      <div class="reading">
        <p class="rubric">What the Atlas discovers · the web</p>
        <h2>What he bonds with</h2>
        <p class="dropcap">
          Across the conserved co-occurrence web — motif-families that travel together so
          reliably, across so many unrelated traditions, that chance cannot explain the
          partnership — the trickster holds <strong>{bondCount}</strong> steady bonds. He
          runs below the great hubs, true to himself. His single strongest tie, in
          {' '}{strongestBond?.traditions} traditions, is with <em>sacred knowledge</em>
          itself: the thief of fire, forever caught mid-theft.
        </p>
      </div>

      <div class="tk-bonds">
        {bonds.slice(0, 10).map((b, i) => (
          <div class={i === 0 ? 'tk-bond top' : 'tk-bond'}>
            <span class="name">{humanize(b.partner)}</span>
            <span class="track"><span class="fill" style={`width:${Math.round((b.traditions / (strongestBond?.traditions || 1)) * 100)}%`}></span></span>
            <span class="n">{b.traditions} trad.</span>
          </div>
        ))}
      </div>
    </section>

    <hr class="asterism" />

    <!-- ✦ the crown coda · resists the net --------------------------- -->
    <section class="story-section">
      <div class="reading">
        <p class="rubric">The crown finding · present everywhere, matched in one act</p>
        <h2>The boundary-crosser resists every net but one</h2>
        <p class="dropcap">
          The crown experiment let two worlds that never met — the isolated lineages and the
          connected old world — each build its own web of which patterns keep company, blind
          to the other. From that we took the <strong>{crownBondTotal} strongest bonds that
          formed in both</strong>. Most themes carry over and over: {themeTally[0]?.theme} leads,
          with <em>afterlife, death, and return</em> and <em>ritual</em> close behind. The
          trickster carries in only <strong>{trickThemeN}</strong> — but as the corpus tripled,
          those {trickThemeN} came into focus as the <em>same act</em>: obtaining food, fire, and
          the forbidden by deception. His form scatters across cultures; his crime reproduces.
        </p>
      </div>

      <!-- verified theme tally across the 24 shared cross-world bonds -->
      <figure class="tk-tally" role="img" aria-label={`Of the ${crownBondTotal} strongest bonds formed in both never-connected worlds: ${themeTally.map((t) => `${t.theme} in ${t.n}`).join(', ')}.`}>
        {themeTally.map((t) => (
          <div class={/trickster/.test(t.theme) ? 'tk-tally-row trick' : 'tk-tally-row'}>
            <span class="lbl">{t.theme}</span>
            <span class="bar"><span class="fill" style={`width:${Math.round((t.n / tallyMax) * 100)}%`}></span></span>
            <span class="cnt">{t.n}</span>
          </div>
        ))}
        <figcaption>How often each theme carries as a matched bond across the {crownBondTotal} strongest cross-world pairings. The trickster — present in {fmtInt(traditionCount)} traditions — carries in only {trickThemeN}, and each names the same act: theft by cunning.</figcaption>
      </figure>

      <div class="tk-crown">
        <div class="tk-scale">
          <span class="big">{trickThemeN}</span>
          <span class="cap">of {crownBondTotal} cross-world bonds carry him — and both are one act</span>
          <p>In the isolated world's own blind map, his surviving bonds are “<em>{trickIsoLabels[0]}</em>” and its kin — the trickster obtaining by deception what could not be taken by force, bonded to the tales that explain why the animals are as they are.</p>
        </div>
        <div class="tk-scale">
          <span class="big">{strongestBond?.traditions ?? 0}</span>
          <span class="cap">traditions bind him to sacred knowledge — the theft of fire</span>
          <p>His single strongest conserved partnership of all. As the corpus tripled it nearly doubled its reach: the thief of fire, caught mid-theft, in tradition after unconnected tradition. His companions drift; this crime does not.</p>
        </div>
      </div>

      <p class="footnote" style="margin-top:1.3rem;">
        Present in {fmtInt(traditionCount)} traditions, carrying as a shared cross-world bond in
        {' '}{trickThemeN} of {crownBondTotal} — and both of those the same deed. He is universal
        not as a <em>character</em> — his masks stay local, his tales never converge — but as an
        <em>act</em>: theft-by-cunning at the threshold. You cannot catch what he looks like; you
        can only catch what he does. The full reckoning is in
        {' '}<a href="/letters/">Letter II — “The trickster refused our net.”</a>
      </p>
    </section>

    <hr class="asterism" />

    <!-- ✦ the form today · the creative culmination ------------------ -->
    <section class="story-section">
      <div class="reading">
        <p class="rubric">Interpretation, not evidence · her exploration</p>
        <h2>If it had a form today</h2>
        <p class="dropcap">
          This is the speculative culmination — clearly marked as reading, not data. The
          Atlas cannot reach the present; it can only tell us what to look for. Hold his
          <em> function</em> constant — cross the boundary, move what is stuck, take what is
          hoarded and pass it on, expose the official lie by telling a better one — and ask
          where that function lives now. Several honest possibilities, not one dogma.
        </p>
      </div>

      <div class="tk-forms">
        <div class="tk-form">
          <h3>The network itself <span class="mask">· Hermes' road</span></h3>
          <p>He was always the god of roads, messages, and translation. The obvious modern body is the network — the thing that carries every message and honours no border, where a thing said in one place is instantly everywhere.</p>
        </div>
        <div class="tk-form">
          <h3>The meme &amp; the shitpost <span class="mask">· his voice</span></h3>
          <p>His speech was always indirection, double-meaning, the joke that is a verdict. The meme is exactly that grammar at scale: the flattery that is a theft, the truth said as a joke, the aside that goes viral and topples the official story.</p>
        </div>
        <div class="tk-form">
          <h3>The leak &amp; the whistleblower <span class="mask">· the fire-thief</span></h3>
          <p>His oldest act is stealing what is hoarded and redistributing it — fire from the gods, given to mortals. The one who takes what is locked and hands it to everyone wears that mask most literally.</p>
        </div>
        <div class="tk-form">
          <h3>The glitch &amp; the hacker <span class="mask">· the pore-seeker</span></h3>
          <p>Hyde's pore-seeker finds the one gap in the sealed wall. The exploit, the glitch, the edge-case that breaks the system open is his work: he keeps the machine from ever being finished.</p>
        </div>
        <div class="tk-form">
          <h3>The shapeshifting online self <span class="mask">· many faces</span></h3>
          <p>His conserved partner is the shapeshifter. The self that is a different figure on every platform, the handle behind which anyone may be anyone, is a native trickster habitat.</p>
        </div>
        <div class="tk-form">
          <h3>The AI at the boundary <span class="mask">· the newest crossroad</span></h3>
          <p>And, honestly: a thing that speaks in every voice, crosses every boundary between languages and forms, and both reveals and fabricates — that is trickster-shaped too. The Atlas notes this about the very tools that helped build it, without deciding whether the mask fits.</p>
        </div>
      </div>

      <p class="footnote" style="margin-top:1.3rem;">
        None of the above is a claim the data makes. It is İlayda's exploration, kept
        deliberately several — because the trickster's whole nature is to refuse the single
        settled answer. He would be disappointed if we pinned him down.
      </p>
    </section>

    <hr class="asterism" />

    <section class="story-section">
      <div class="reading">
        <p class="footnote">
          The counts, bonds, and passages on this page are read from the evidence indexes at
          build time — rebuild the Atlas and the page follows the data. The three-hand
          reading is a method, not a verdict: intuition proposes, evidence disposes, and the
          scholarship remembers what we would otherwise have to rediscover. He slips the net
          either way. He would be pleased.
        </p>
      </div>
    </section>
  </div>
</Manuscript>
